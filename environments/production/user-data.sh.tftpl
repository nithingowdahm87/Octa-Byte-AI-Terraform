#!/bin/bash
set -e
exec > >(tee -a /var/log/user-data.log) 2>&1

# 1. Install packages
dnf update -y
sysctl -w vm.max_map_count=262144
echo "vm.max_map_count=262144" >> /etc/sysctl.conf

dnf install -y docker awscli jq amazon-cloudwatch-agent
curl -SL https://github.com/docker/compose/releases/latest/download/docker-compose-linux-x86_64 -o /usr/local/bin/docker-compose
chmod +x /usr/local/bin/docker-compose
ln -sf /usr/local/bin/docker-compose /usr/bin/docker-compose

# 2. Enable and start docker
systemctl enable --now docker

# 3. Add ec2-user to docker group
usermod -aG docker ec2-user

# 4. Enable amazon-ssm-agent and cloudwatch agent
systemctl enable --now amazon-ssm-agent
systemctl enable --now amazon-cloudwatch-agent

# 5. Create directories
mkdir -p /opt/octabyte-nithin/bin /opt/octabyte-nithin/compose /var/log/octabyte-nithin
chmod 0755 /opt/octabyte-nithin/bin /opt/octabyte-nithin/compose /var/log/octabyte-nithin

# 6. Write deploy.sh
cat << 'INNER_EOF' > /opt/octabyte-nithin/bin/deploy.sh
#!/bin/bash
set -e
exec > >(tee -a /var/log/octabyte-nithin/deploy.log) 2>&1

IMAGE_URI=$1

if [[ -z "$IMAGE_URI" ]]; then
  echo "Error: Must provide IMAGE_URI"
  exit 1
fi

if [[ "$IMAGE_URI" != *"@sha256:"* ]]; then
  echo "Error: IMAGE_URI must include @sha256: for immutability"
  exit 1
fi

echo "Deploying $IMAGE_URI"

ECR_REGISTRY=$(echo "$IMAGE_URI" | cut -d/ -f1)
REGION=$(echo "$ECR_REGISTRY" | cut -d. -f4)

aws ecr get-login-password --region "$REGION" | docker login --username AWS --password-stdin "$ECR_REGISTRY"

DB_SECRET_JSON=$(aws secretsmanager get-secret-value --secret-id ${db_host_secret_arn} --region ${region} --query SecretString --output text)
DB_HOST="${db_endpoint}"
DB_PASS=$(echo "$DB_SECRET_JSON" | jq -r '.password // empty')
DB_NAME=$(echo "$DB_SECRET_JSON" | jq -r '.dbname // empty')
DB_USER="appadmin"

cat << RUNTIME_EOF > /opt/octabyte-nithin/compose/.env.runtime
DATABASE_HOST=$DB_HOST
DATABASE_PASSWORD=$DB_PASS
DATABASE_USERNAME=$DB_USER
DATABASE_NAME=$DB_NAME
DATABASE_PORT=5432
RUNTIME_EOF

# Write nginx config
mkdir -p /opt/octabyte-nithin/compose/nginx/sites-enabled
cat << NGINX_EOF > /opt/octabyte-nithin/compose/nginx/sites-enabled/flask_project.conf
upstream app {
    server app:8000;
}
server {
    listen 80;
    charset utf-8;
    location /static {
        alias /static/;
    }
    location / {
        proxy_pass http://app;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
    }
}
NGINX_EOF

# Save atomic rollback records before starting
if [ -f /opt/octabyte-nithin/compose/docker-compose.aws.yml ]; then
    cp /opt/octabyte-nithin/compose/docker-compose.aws.yml /opt/octabyte-nithin/compose/previous-compose.yml
fi
if [ -f /opt/octabyte-nithin/current-image-uri ]; then
    cp /opt/octabyte-nithin/current-image-uri /opt/octabyte-nithin/previous-image-uri
fi
echo "$IMAGE_URI" > /opt/octabyte-nithin/current-image-uri

cat << COMPOSE_EOF > /opt/octabyte-nithin/compose/docker-compose.aws.yml
services:
  nginx:
    image: nginx:alpine
    ports:
      - "80:80"
    depends_on:
      - app
    networks:
      - prod_network
    volumes:
      - /opt/octabyte-nithin/compose/nginx/sites-enabled:/etc/nginx/conf.d

  app:
    image: PLACEHOLDER_IMAGE
    env_file: .env.runtime
    expose:
      - "8000"
    networks:
      - prod_network

networks:
  prod_network:
    driver: bridge
COMPOSE_EOF

sed -i "s|PLACEHOLDER_IMAGE|$IMAGE_URI|g" /opt/octabyte-nithin/compose/docker-compose.aws.yml

cd /opt/octabyte-nithin/compose
docker-compose -f docker-compose.aws.yml pull
docker-compose -f docker-compose.aws.yml up -d --remove-orphans

# Healthcheck loop
echo "Waiting for healthcheck on port 80..."
for i in {1..30}; do
  if curl -sf http://localhost:80/health >/dev/null; then
    echo "Healthcheck passed"
    exit 0
  fi
  sleep 5
done
echo "Healthcheck failed"
exit 1
INNER_EOF
chmod +x /opt/octabyte-nithin/bin/deploy.sh

# 7. Write rollback.sh
cat << 'INNER_EOF' > /opt/octabyte-nithin/bin/rollback.sh
#!/bin/bash
set -e
exec > >(tee -a /var/log/octabyte-nithin/rollback.log) 2>&1

if [ ! -f /opt/octabyte-nithin/previous-image-uri ] || [ ! -f /opt/octabyte-nithin/compose/previous-compose.yml ]; then
    echo "No previous state to rollback to."
    exit 1
fi

PREVIOUS_IMAGE=$(cat /opt/octabyte-nithin/previous-image-uri)
echo "Rolling back to $PREVIOUS_IMAGE"

cp /opt/octabyte-nithin/compose/previous-compose.yml /opt/octabyte-nithin/compose/docker-compose.aws.yml

cd /opt/octabyte-nithin/compose
docker-compose -f docker-compose.aws.yml up -d --remove-orphans

# Restore state files
mv /opt/octabyte-nithin/previous-image-uri /opt/octabyte-nithin/current-image-uri
echo "Rollback completed."
INNER_EOF
chmod +x /opt/octabyte-nithin/bin/rollback.sh


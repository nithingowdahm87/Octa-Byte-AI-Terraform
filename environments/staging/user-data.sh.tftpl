#!/bin/bash
set -e
exec > >(tee -a /var/log/user-data.log) 2>&1

# 1. Install packages
dnf update -y
sysctl -w vm.max_map_count=262144
echo "vm.max_map_count=262144" >> /etc/sysctl.conf

dnf install -y docker docker-compose-plugin awscli jq amazon-cloudwatch-agent

# 2. Enable and start docker
systemctl enable --now docker

# 3. Add ec2-user to docker group
usermod -aG docker ec2-user

# 4. Enable amazon-ssm-agent and cloudwatch agent
systemctl enable --now amazon-ssm-agent
systemctl enable --now amazon-cloudwatch-agent

# 5. Create directories
mkdir -p /opt/octabyte-nithin/bin /opt/octabyte-nithin/compose /var/log/octabyte-nithin
chmod 0755 /opt/octabyte-nithin/bin /opt/octabyte-nithin/compose /var/log/octabyte-nithin

# 6. Write deploy-staging.sh
cat << 'INNER_EOF' > /opt/octabyte-nithin/bin/deploy-staging.sh
#!/bin/bash
set -e
exec > >(tee -a /var/log/octabyte-nithin/deploy-staging.log) 2>&1

IMAGE_URI=$1

if [[ -z "$IMAGE_URI" ]]; then
  echo "Error: Must provide IMAGE_URI"
  exit 1
fi

if [[ "$IMAGE_URI" != *"@sha256:"* ]]; then
  echo "Error: IMAGE_URI must include @sha256: for immutability"
  exit 1
fi

echo "Deploying $IMAGE_URI"

ECR_REGISTRY=$(echo "$IMAGE_URI" | cut -d/ -f1)
REGION=$(echo "$ECR_REGISTRY" | cut -d. -f4)

# Authenticate to ECR
aws ecr get-login-password --region "$REGION" | docker login --username AWS --password-stdin "$ECR_REGISTRY"

# Write docker-compose.staging.yml
cat << COMPOSE_EOF > /opt/octabyte-nithin/compose/docker-compose.staging.yml
version: '3.8'

services:
  nginx:
    image: nginx:alpine
    ports:
      - "80:80"
    depends_on:
      - app
    networks:
      - staging_network

  app:
    image: \$IMAGE_URI
    environment:
      - DATABASE_HOST=db
      - DATABASE_PORT=5432
      - DATABASE_NAME=postgres
      - DATABASE_USERNAME=postgres
      - DATABASE_PASSWORD=staging_password
    depends_on:
      - db
    networks:
      - staging_network

  db:
    image: postgres:15-alpine
    environment:
      - POSTGRES_DB=postgres
      - POSTGRES_USER=postgres
      - POSTGRES_PASSWORD=staging_password
    volumes:
      - db_data:/var/lib/postgresql/data
    networks:
      - staging_network

  sonarqube:
    image: sonarqube:community
    container_name: sonarqube
    hostname: sonarqube
    depends_on:
      sonar_db:
        condition: service_healthy
    environment:
      SONAR_JDBC_URL: jdbc:postgresql://sonar_db:5432/sonar
      SONAR_JDBC_USERNAME: sonar
      SONAR_JDBC_PASSWORD: change-this-password
    volumes:
      - sonarqube_data:/opt/sonarqube/data
      - sonarqube_extensions:/opt/sonarqube/extensions
      - sonarqube_logs:/opt/sonarqube/logs
      - sonarqube_temp:/opt/sonarqube/temp
    ports:
      - "9000:9000"
    restart: unless-stopped
    networks:
      - staging_network

  sonar_db:
    image: postgres:17
    container_name: sonarqube-db
    hostname: postgresql
    environment:
      POSTGRES_USER: sonar
      POSTGRES_PASSWORD: change-this-password
      POSTGRES_DB: sonar
    volumes:
      - postgresql_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U sonar -d sonar"]
      interval: 10s
      timeout: 5s
      retries: 10
    restart: unless-stopped
    networks:
      - staging_network

networks:
  staging_network:
    driver: bridge

volumes:
  db_data:
  sonarqube_data:
  sonarqube_extensions:
  sonarqube_logs:
  sonarqube_temp:
  postgresql_data:
COMPOSE_EOF

cd /opt/octabyte-nithin/compose
docker compose -f docker-compose.staging.yml pull
docker compose -f docker-compose.staging.yml up -d --remove-orphans

# Healthcheck loop
echo "Waiting for healthcheck on port 80..."
for i in {1..30}; do
  if curl -s http://localhost:80/health >/dev/null; then
    echo "Healthcheck passed"
    exit 0
  fi
  sleep 5
done
echo "Healthcheck failed"
exit 1
INNER_EOF
chmod +x /opt/octabyte-nithin/bin/deploy-staging.sh

# 7. Write rollback-staging.sh
cat << 'INNER_EOF' > /opt/octabyte-nithin/bin/rollback-staging.sh
#!/bin/bash
set -e
exec > >(tee -a /var/log/octabyte-nithin/rollback-staging.log) 2>&1

echo "Rollback script placeholder - implement specific rollback logic if state tracking is added"
cd /opt/octabyte-nithin/compose
docker compose -f docker-compose.staging.yml down
INNER_EOF
chmod +x /opt/octabyte-nithin/bin/rollback-staging.sh
